rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function verified(){return signed()&&request.auth.token.email_verified==true;}
  function accessPath(){return /databases/$(database)/documents/adminAccess/$(request.auth.uid);}
  function hasAccess(){return signed()&&exists(accessPath());}
  function role(){return hasAccess()?get(accessPath()).data.role:'';}
  function active(){return hasAccess()&&get(accessPath()).data.active==true;}
  function pm(){return active()&&role()=='projectControlsManager';}
  function owner(){return active()&&role()=='systemOwner';}
  function admin(){return pm()||owner();}
  function profilePath(){return /databases/$(database)/documents/users/$(request.auth.uid);}
  function hasProfile(){return signed()&&exists(profilePath());}
  function profile(){return get(profilePath()).data;}
  function staff(r){return r in ['supervisor','senior','expert','intern'];}
  function activeStaff(){return hasProfile()&&profile().status=='active'&&staff(profile().role);}
  function validStatus(d){return d.status in ['todo','doing','blocked','review','done']&&(d.status!='blocked'||(d.blockReason is string&&d.blockReason.size()>0));}
  function teamRead(d){return admin()||(activeStaff()&&(d.createdByUid==request.auth.uid||d.assigneeUid==request.auth.uid));}
  function readTask(d){return d.visibility=='manager_private'?(pm()&&d.assigneeUid==request.auth.uid):d.visibility=='owner_private'?(owner()&&d.assigneeUid==request.auth.uid):teamRead(d);}
  function projectOk(p){return p==''||admin()||(activeStaff()&&p in profile().projectIds);}
  function recurrencePath(s){return /databases/$(database)/documents/recurrences/$(s);}
  function taskPath(id){return /databases/$(database)/documents/tasks/$(id);}
  function instancePath(id){return /databases/$(database)/documents/recurrenceInstances/$(id);}
  function eventPath(id){return /databases/$(database)/documents/activityHistory/$(id);}
  // Effective origin is the recurrence author, not the device that created the occurrence.
  function ownOrigin(d){return activeStaff()&&(d.visibility=='team')&&
    (d.get('seriesId','')==''?d.createdByUid==request.auth.uid:
      (exists(recurrencePath(d.seriesId))&&get(recurrencePath(d.seriesId)).data.createdByUid==request.auth.uid));}
  function canStaffDelete(d){return ownOrigin(d);}
  function staffTaskFields(d){return ownOrigin(d)?
    ['title','projectId','due','priority','description','status','blockReason','notes','submittedAt','updatedAt']:
    ['status','blockReason','notes','submittedAt','updatedAt'];}
  function canCreateDeletionMarker(id){return admin()||(activeStaff()&&
    ((exists(taskPath(id))&&canStaffDelete(get(taskPath(id)).data))||
     (exists(instancePath(id))&&canStaffDelete(get(instancePath(id)).data))));}

  function deletionPath(id){return /databases/$(database)/documents/deletedTasks/$(id);}
  // Any role may materialize an existing approved occurrence, but cannot invent
  // the assignee, visibility, project, or manager-assigned weight.
  function createOccurrence(d){
    return (admin()||activeStaff())&&d.seriesId is string&&exists(recurrencePath(d.seriesId))
      &&get(recurrencePath(d.seriesId)).data.state=='active'
      &&d.createdByUid==get(recurrencePath(d.seriesId)).data.createdByUid&&d.get('materializedByUid',request.auth.uid)==request.auth.uid&&validStatus(d)
      &&d.assigneeUid==get(recurrencePath(d.seriesId)).data.assigneeUid
      &&d.visibility==get(recurrencePath(d.seriesId)).data.visibility
      &&d.projectId==get(recurrencePath(d.seriesId)).data.projectId
      &&d.get('weight',0)==get(recurrencePath(d.seriesId)).data.get('weight',0)
      // Existing approved series plus exact assignee/project match authorizes this occurrence.
      // Do not reject an assigned recurrence solely because the profile project list is stale.
      &&(d.visibility=='team'?(admin()||d.assigneeUid==request.auth.uid):d.visibility=='manager_private'?(pm()&&d.assigneeUid==request.auth.uid):(owner()&&d.visibility=='owner_private'&&d.assigneeUid==request.auth.uid));
  }
  function createTask(d){return (admin()||activeStaff())&&d.createdByUid==request.auth.uid&&d.assigneeUid is string&&d.assigneeUid!=''&&d.visibility in ['team','manager_private','owner_private']&&validStatus(d)&&(admin()||!('weight' in request.resource.data)||request.resource.data.weight==0)&&projectOk(d.projectId)&&(d.visibility=='team'?(d.assigneeUid==request.auth.uid||admin()):d.visibility=='manager_private'?(pm()&&d.assigneeUid==request.auth.uid):(owner()&&d.assigneeUid==request.auth.uid));}
  function createRec(d){return (admin()||activeStaff())&&d.createdByUid==request.auth.uid&&d.assigneeUid is string&&d.visibility in ['team','manager_private','owner_private']&&d.frequency in ['daily','weekly','monthly']&&(admin()||!('weight' in request.resource.data)||request.resource.data.weight==0)&&projectOk(d.projectId)&&(d.visibility=='team'?(d.assigneeUid==request.auth.uid||admin()):d.visibility=='manager_private'?(pm()&&d.assigneeUid==request.auth.uid):(owner()&&d.assigneeUid==request.auth.uid));}
  function staffUpdate(d){return activeStaff()&&d.visibility=='team'&&
    (d.createdByUid==request.auth.uid||d.assigneeUid==request.auth.uid)&&
    request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffTaskFields(d))&&
    validStatus(request.resource.data)&&
    (request.resource.data.projectId==resource.data.projectId||projectOk(request.resource.data.projectId))&&
    request.resource.data.createdByUid==resource.data.createdByUid&&
    request.resource.data.assigneeUid==resource.data.assigneeUid&&
    request.resource.data.visibility==resource.data.visibility&&
    request.resource.data.get('weight',0)==resource.data.get('weight',0);}

  function ownerTaskUpdate(){return owner()&&resource.data.visibility=='team'&&request.resource.data.visibility=='team'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','projectId','due','priority','description','status','blockReason','notes','submittedAt','updatedAt','assigneeUid','createdByUid','visibility','weight','evalId'])&&request.resource.data.get('weight',0)==resource.data.get('weight',0);}
  match /adminAccess/{uid}{allow get:if signed()&&request.auth.uid==uid;allow list:if false;allow create:if verified()&&request.auth.uid==uid&&request.resource.data.uid==uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.active==true&&request.resource.data.role==(request.auth.token.email=='behrooz73.vosough@gmail.com'?'projectControlsManager':request.auth.token.email=='arashlavasani891@gmail.com'?'systemOwner':'')&&request.resource.data.keys().hasOnly(['uid','email','name','role','active','createdAt']);allow update,delete:if false;}
  match /membershipRequests/{uid}{allow get:if(signed()&&request.auth.uid==uid)||admin();allow list:if admin();allow create:if signed()&&request.auth.uid==uid&&request.resource.data.uid==uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.status=='pending'&&request.resource.data.keys().hasOnly(['uid','email','name','status','createdAt']);allow update:if admin()&&request.resource.data.uid==uid&&request.resource.data.email==resource.data.email&&request.resource.data.status in ['pending','approved','rejected'];allow delete:if false;}
  match /users/{uid}{allow get:if(signed()&&request.auth.uid==uid)||admin();allow list:if admin();allow create,update:if admin()&&request.resource.data.uid==uid&&request.resource.data.email is string&&(request.resource.data.status=='disabled'||staff(request.resource.data.role));allow delete:if pm()&&uid!=request.auth.uid;}
  match /projects/{id}{allow get:if admin()||(activeStaff()&&id in profile().projectIds);allow list:if admin();allow create,update,delete:if admin();}
  match /tasks/{id}{allow get:if ((admin()||activeStaff())&&!exists(taskPath(id)))||readTask(resource.data);allow list:if readTask(resource.data);allow create:if !exists(deletionPath(id))&&createTask(request.resource.data);allow update:if validStatus(request.resource.data)&&request.resource.data.createdByUid==resource.data.createdByUid&&((pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||(owner()&&resource.data.visibility=='owner_private'&&resource.data.assigneeUid==request.auth.uid)||ownerTaskUpdate()||staffUpdate(resource.data));allow delete:if (pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||(owner()&&(resource.data.visibility=='team'||(resource.data.visibility=='owner_private'&&resource.data.assigneeUid==request.auth.uid)))||canStaffDelete(resource.data);}
  match /recurrences/{id}{allow get:if (admin()&&!exists(recurrencePath(id)))||readTask(resource.data);allow list:if readTask(resource.data);allow create:if createRec(request.resource.data)&&request.resource.data.state in ['pending','active'];allow update:if(pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||(owner()&&resource.data.visibility=='owner_private'&&resource.data.assigneeUid==request.auth.uid)||(owner()&&resource.data.visibility=='team'&&request.resource.data.visibility=='team'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','projectId','start','end','frequency','weekday','monthDay','workOnly','description','state','updatedAt','assigneeUid','createdByUid','visibility','weight','excluded'])&&request.resource.data.get('weight',0)==resource.data.get('weight',0))||(activeStaff()&&resource.data.visibility=='team'&&resource.data.createdByUid==request.auth.uid&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['excluded']));allow delete:if(pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||(owner()&&(resource.data.visibility=='team'||(resource.data.visibility=='owner_private'&&resource.data.assigneeUid==request.auth.uid)))||(activeStaff()&&resource.data.visibility=='team'&&resource.data.createdByUid==request.auth.uid);}
  match /recurrenceInstances/{id}{allow get:if(signed()&&!exists(/databases/$(database)/documents/recurrenceInstances/$(id))&&(activeStaff()||pm()||owner()))||readTask(resource.data);allow list:if readTask(resource.data);allow create:if !exists(deletionPath(id))&&createOccurrence(request.resource.data);allow update:if validStatus(request.resource.data)&&request.resource.data.createdByUid==resource.data.createdByUid&&((pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||(owner()&&resource.data.visibility=='owner_private'&&resource.data.assigneeUid==request.auth.uid)||ownerTaskUpdate()||staffUpdate(resource.data));allow delete:if (pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||(owner()&&(resource.data.visibility=='team'||(resource.data.visibility=='owner_private'&&resource.data.assigneeUid==request.auth.uid)))||canStaffDelete(resource.data);}
  match /evaluations/{id}{allow get,list:if admin();allow create:if admin()&&request.resource.data.score is number&&request.resource.data.score>=0&&request.resource.data.score<=100&&((exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId))&&get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.visibility=='team')||(exists(/databases/$(database)/documents/recurrenceInstances/$(request.resource.data.taskId))&&get(/databases/$(database)/documents/recurrenceInstances/$(request.resource.data.taskId)).data.visibility=='team'));allow update:if admin()&&request.resource.data.taskId==resource.data.taskId;allow delete:if false;}
  match /activityHistory/{id}{allow get:if ((admin()||activeStaff())&&!exists(eventPath(id)))||(resource.data.visibility=='manager_private'?(pm()&&resource.data.ownerUid==request.auth.uid):resource.data.visibility=='owner_private'?(owner()&&resource.data.ownerUid==request.auth.uid):(resource.data.visibility=='team'&&(admin()||(activeStaff()&&resource.data.get('kind','')!='grade'&&(resource.data.actorUid==request.auth.uid||resource.data.assigneeUid==request.auth.uid||resource.data.createdByUid==request.auth.uid)))));allow list:if resource.data.visibility=='manager_private'?(pm()&&resource.data.ownerUid==request.auth.uid):resource.data.visibility=='owner_private'?(owner()&&resource.data.ownerUid==request.auth.uid):(resource.data.visibility=='team'&&(admin()||(activeStaff()&&resource.data.get('kind','')!='grade'&&(resource.data.actorUid==request.auth.uid||resource.data.assigneeUid==request.auth.uid||resource.data.createdByUid==request.auth.uid))));allow create:if (admin()||activeStaff())&&request.resource.data.actorUid==request.auth.uid&&request.resource.data.taskId is string&&request.resource.data.createdByUid is string&&((request.resource.data.visibility=='team'&&(request.resource.data.assigneeUid==request.auth.uid||request.resource.data.createdByUid==request.auth.uid||admin()))||(((request.resource.data.visibility=='manager_private'&&pm())||(request.resource.data.visibility=='owner_private'&&owner()))&&request.resource.data.ownerUid==request.auth.uid&&request.resource.data.assigneeUid==request.auth.uid));allow update,delete:if false;}
  // Immutable deletion markers prevent old offline clients resurrecting deleted task IDs.
  match /deletedTasks/{id}{
    allow get:if signed();
    allow list:if false;
    allow create:if canCreateDeletionMarker(id)&&request.resource.data.deleted==true
      &&request.resource.data.keys().hasOnly(['deleted','deletedAt']);
    allow update,delete:if false;
  }
  match /settings/{id}{allow get,list:if admin();allow create,update,delete:if owner();}
  match /{doc=**}{allow read,write:if false;}
 }
}
