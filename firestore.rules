rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signed(){return request.auth!=null;}
  function verified(){return signed()&&request.auth.token.email_verified==true;}
  function accessPath(){return /databases/$(database)/documents/adminAccess/$(request.auth.uid);}
  function hasAccess(){return signed()&&exists(accessPath());}
  function role(){return hasAccess()?get(accessPath()).data.role:'';}
  function active(){return hasAccess()&&get(accessPath()).data.active==true;}
  function pm(){return active()&&role()=='projectControlsManager';}
  function owner(){return active()&&role()=='systemOwner';}
  function admin(){return pm()||owner();}
  function profilePath(){return /databases/$(database)/documents/users/$(request.auth.uid);}
  function hasProfile(){return signed()&&exists(profilePath());}
  function profile(){return get(profilePath()).data;}
  function staff(r){return r in ['supervisor','senior','expert','intern'];}
  function validStatus(d){return d.status in ['todo','doing','blocked','review','done']&&(d.status!='blocked'||(d.blockReason is string&&d.blockReason.size()>0));}
  function teamRead(d){return admin()||(signed()&&(d.createdByUid==request.auth.uid||d.assigneeUid==request.auth.uid));}
  function readTask(d){return d.visibility=='manager_private'?(pm()&&d.assigneeUid==request.auth.uid):teamRead(d);}
  function projectOk(p){return p==''||admin()||(hasProfile()&&p in profile().projectIds);}
  function createTask(d){return verified()&&d.createdByUid==request.auth.uid&&d.assigneeUid is string&&d.assigneeUid!=''&&d.visibility in ['team','manager_private']&&validStatus(d)&&(pm()||!('weight' in request.resource.data)||request.resource.data.weight==0)&&projectOk(d.projectId)&&(d.visibility=='team'?(d.assigneeUid==request.auth.uid||admin()):(pm()&&d.assigneeUid==request.auth.uid));}
  function createRec(d){return verified()&&d.createdByUid==request.auth.uid&&d.assigneeUid is string&&d.visibility in ['team','manager_private']&&d.frequency in ['daily','weekly','monthly']&&(pm()||!('weight' in request.resource.data)||request.resource.data.weight==0)&&projectOk(d.projectId)&&(d.visibility=='team'?(d.assigneeUid==request.auth.uid||admin()):(pm()&&d.assigneeUid==request.auth.uid));}
  function staffUpdate(d){return verified()&&d.visibility=='team'&&(d.createdByUid==request.auth.uid||d.assigneeUid==request.auth.uid)&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','projectId','due','priority','description','status','blockReason','notes','submittedAt','updatedAt'])&&request.resource.data.status in ['todo','doing','blocked','review','done']&&projectOk(request.resource.data.projectId)&&request.resource.data.createdByUid==resource.data.createdByUid&&request.resource.data.assigneeUid==resource.data.assigneeUid&&request.resource.data.visibility==resource.data.visibility&&request.resource.data.get('weight',0)==resource.data.get('weight',0);}
  function ownerTaskUpdate(){return owner()&&resource.data.visibility=='team'&&request.resource.data.visibility=='team'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','projectId','due','priority','description','status','blockReason','notes','submittedAt','updatedAt','assigneeUid','createdByUid','visibility','weight'])&&request.resource.data.get('weight',0)==resource.data.get('weight',0);}
  match /adminAccess/{uid}{allow get:if signed()&&request.auth.uid==uid;allow list,create,update,delete:if false;}
  match /membershipRequests/{uid}{allow get:if(signed()&&request.auth.uid==uid)||admin();allow list:if admin();allow create:if verified()&&request.auth.uid==uid&&request.resource.data.uid==uid&&request.resource.data.email==request.auth.token.email&&request.resource.data.status=='pending'&&request.resource.data.keys().hasOnly(['uid','email','name','status','createdAt']);allow update:if admin()&&request.resource.data.uid==uid&&request.resource.data.email==resource.data.email&&request.resource.data.status in ['pending','approved','rejected'];allow delete:if false;}
  match /users/{uid}{allow get:if(signed()&&request.auth.uid==uid)||admin();allow list:if admin();allow create,update:if admin()&&request.resource.data.uid==uid&&request.resource.data.email is string&&(request.resource.data.status=='disabled'||staff(request.resource.data.role));allow delete:if pm()&&uid!=request.auth.uid;}
  match /projects/{id}{allow get:if admin()||(hasProfile()&&id in profile().projectIds);allow list:if admin();allow create,update,delete:if admin();}
  match /tasks/{id}{allow get,list:if readTask(resource.data);allow create:if createTask(request.resource.data);allow update:if validStatus(request.resource.data)&&((pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||ownerTaskUpdate()||staffUpdate(resource.data));allow delete:if pm()&&(resource.data.visibility=='team'||resource.data.assigneeUid==request.auth.uid)||(owner()&&resource.data.visibility=='team');}
  match /recurrences/{id}{allow get,list:if readTask(resource.data);allow create:if createRec(request.resource.data)&&request.resource.data.state in ['pending','active'];allow update:if(pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||(owner()&&resource.data.visibility=='team'&&request.resource.data.visibility=='team'&&request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','projectId','start','end','frequency','weekday','monthDay','workOnly','description','state','updatedAt','assigneeUid','createdByUid','visibility','weight'])&&request.resource.data.get('weight',0)==resource.data.get('weight',0));allow delete:if(pm()&&(resource.data.visibility=='team'||resource.data.assigneeUid==request.auth.uid))||(owner()&&resource.data.visibility=='team');}
  match /recurrenceInstances/{id}{allow get,list:if readTask(resource.data);allow create:if createTask(request.resource.data)&&request.resource.data.seriesId is string&&exists(/databases/$(database)/documents/recurrences/$(request.resource.data.seriesId))&&get(/databases/$(database)/documents/recurrences/$(request.resource.data.seriesId)).data.state=='active';allow update:if validStatus(request.resource.data)&&((pm()&&(resource.data.visibility=='team'||(resource.data.visibility=='manager_private'&&resource.data.assigneeUid==request.auth.uid)))||ownerTaskUpdate()||staffUpdate(resource.data));allow delete:if pm()&&(resource.data.visibility=='team'||resource.data.assigneeUid==request.auth.uid)||(owner()&&resource.data.visibility=='team');}
  match /evaluations/{id}{allow get,list:if admin();allow create:if admin()&&request.resource.data.score is number&&request.resource.data.score>=0&&request.resource.data.score<=100&&((exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId))&&get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data.visibility=='team')||(exists(/databases/$(database)/documents/recurrenceInstances/$(request.resource.data.taskId))&&get(/databases/$(database)/documents/recurrenceInstances/$(request.resource.data.taskId)).data.visibility=='team'));allow update:if admin()&&request.resource.data.taskId==resource.data.taskId;allow delete:if false;}
  match /activityHistory/{id}{allow get,list:if resource.data.visibility=='manager_private'?(pm()&&resource.data.ownerUid==request.auth.uid):(admin()&&resource.data.visibility=='team');allow create:if admin()&&(request.resource.data.visibility=='team'||(pm()&&request.resource.data.visibility=='manager_private'));allow update,delete:if pm()&&resource.data.visibility=='team';}
  match /settings/{id}{allow get,list,create,update,delete:if admin();}
  match /{doc=**}{allow read,write:if false;}
 }
}
